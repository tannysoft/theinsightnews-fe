# Payload secret: openssl rand -hex 32
PAYLOAD_SECRET=
# Shared with apps/web — lets the CMS tell the website to refresh its cache
REVALIDATE_SECRET=
# Shared with apps/web: the "Preview" button opens drafts on the website
PREVIEW_SECRET=
CMS_URL=http://localhost:3001
WEB_URL=http://localhost:3000
# Public media domain (R2). Empty = files served through /api/media/file
MEDIA_URL=https://files.theinsightnews.co
# WordPress to import from (migrate:wp)
WP_URL=https://cms.theinsightnews.co
# Optional: WordPress Application Password, to import drafts and real user emails
WP_USER=
WP_APP_PASSWORD=
# Optional: R2 S3 API for --steps=files/sizes (much faster than wrangler)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=theinsightnews-media
