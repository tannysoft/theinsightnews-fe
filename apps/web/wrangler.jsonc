/**
 * www.theinsightnews.co — the website, reading Payload CMS. Live since the
 * cutover on 2026-11-03; the old WordPress-reading worker (theinsightnews-fe,
 * wrangler.live.jsonc) no longer serves traffic.
 *
 * theinsightnews.co (apex) redirects to www with a zone rule.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "theinsightnews-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "observability": { "enabled": true },
  "routes": [{ "pattern": "www.theinsightnews.co", "custom_domain": true }],
  "vars": {
    // "payload" reads the new CMS; "wordpress" the old one (rollback switch).
    "CMS_SOURCE": "payload",
    "CMS_URL": "https://cms.theinsightnews.co",
    "MEDIA_URL": "https://files.theinsightnews.co"
  },
  // Secrets (wrangler secret put …): REVALIDATE_SECRET and PREVIEW_SECRET (same
  // values as the CMS), CMS_PREVIEW_API_KEY (API key of a CMS user, for drafts),
  // optional CLOUDFLARE_ZONE_ID + CLOUDFLARE_PURGE_TOKEN (edge purge).

  // OpenNext cache (see open-next.config.ts)
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "theinsightnews-web-cache" }],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "theinsightnews-web-tags",
      "database_id": "4f2c6b90-a5da-49d4-b0ce-88918061daa9"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "theinsightnews-web" }]
}
