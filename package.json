{
  "name": "theinsightnews",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @theinsightnews/web dev",
    "dev:cms": "pnpm --filter @theinsightnews/cms dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "deploy:cms": "pnpm --filter @theinsightnews/cms run deploy",
    "deploy:web": "pnpm --filter @theinsightnews/web run deploy",
    "migrate:wp": "pnpm --filter @theinsightnews/cms migrate:wp"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
